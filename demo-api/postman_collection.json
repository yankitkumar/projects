{
  "info": {
    "name": "Demo API",
    "_postman_id": "b3f1e9a0-1a2b-4c3d-9e5f-6789abcdef01",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Get all items",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items",
          "host": ["{{baseUrl}}"],
          "path": ["api", "items"]
        }
      }
    },
    {
      "name": "Get item by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "items", "1"]
        }
      }
    },
    {
      "name": "Create item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread\",\n  \"done\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/items",
          "host": ["{{baseUrl}}"],
          "path": ["api", "items"]
        }
      }
    },
    {
      "name": "Update item",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread, butter\",\n  \"done\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/items/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "items", "1"]
        }
      }
    },
    {
      "name": "Create with specific id (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Custom id item\",\n  \"description\": \"created via PUT\",\n  \"done\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/items/42",
          "host": ["{{baseUrl}}"],
          "path": ["api", "items", "42"]
        }
      }
    },
    {
      "name": "Mark item done",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items/1/done",
          "host": ["{{baseUrl}}"],
          "path": ["api", "items", "1", "done"]
        }
      }
    },
    {
      "name": "Delete item",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "items", "1"]
        }
      }
    }
  ]
}
